# Local Docker Compose / Railway template. Replace the password before use.
CUSTOM_USER=chromium
PASSWORD=CHANGE_THIS_TO_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
PORT=3000
TZ=Asia/Jakarta
HARDEN_DESKTOP=true
DISPLAY_SIZEW=1280
DISPLAY_SIZEH=720
DISPLAY_REFRESH=30
SELKIES_MANUAL_RESOLUTION=true
SELKIES_MANUAL_WIDTH=1280
SELKIES_MANUAL_HEIGHT=720
SELKIES_FRAMERATE=30-30
SELKIES_FILE_TRANSFERS=upload,download
SELKIES_UI_SIDEBAR_SHOW_FILES=true
